# Copy to .env and supply credentials through your local secret mechanism.
APP_NAME="WED STUDIOZS"
ENVIRONMENT=development
DEBUG=false

# Required. Generate a unique random secret (>=32 characters), identical across replicas:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Option A: inject DATABASE_URL (postgresql:// is normalized to the async driver).
# Percent-encode credentials when constructing a URL outside this application.
# DATABASE_URL=
#
# Option B: omit DATABASE_URL and supply separate fields; passwords are encoded safely.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=wedstudiozs
DATABASE_USER=postgres
DATABASE_PASSWORD=
DB_ECHO=false

# Per worker/process. Budget (pool size + overflow) * peak rollout processes against DB capacity.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=2
DB_POOL_RECYCLE_SECONDS=900
SCHEMA_CHECK_TIMEOUT_SECONDS=3

# Apply migrations BEFORE starting the app: alembic upgrade head
# Startup and /readyz check the migrated schema; /healthz is DB-independent.
# Explicit bootstrap (hidden password prompt): python -m app.cli create-admin --email you@example.com
# Automation may pipe one password line using --password-stdin; never put passwords in argv.
# Optional sample portfolios only: python -m app.cli seed-demo
# /metrics exposes process-local Prometheus metrics; restrict scrape access at the platform edge.

BUSINESS_PHONE="+91 98765 43210"
BUSINESS_EMAIL=hello@wedstudiozs.com
BUSINESS_ADDRESS="2nd Floor, Jubilee Hills, Hyderabad, India"
CORS_ORIGINS=["http://localhost:8000"]
